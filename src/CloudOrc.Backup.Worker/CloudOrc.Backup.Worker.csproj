<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Isolated per-job backup worker. Started by the Backup Agent for each job inside the OS
    resource limits (Windows Job Object / Linux nice+ionice / macOS background priority);
    talks JSON lines over stdin/stdout; drives Kopia found in the Engines directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CloudOrc.Backup.Worker</RootNamespace>
    <AssemblyName>cloudorc-backup-worker</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CloudOrc.Agent.Contracts\CloudOrc.Agent.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- MS SQL Server backup / restore (BACKUP DATABASE ... COPY_ONLY, RESTORE). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient's transitive 9.0.x has known advisories; take the patched 10.0 build. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\PostgresLocator.cs" Link="Shared\PostgresLocator.cs" />
    <Compile Include="..\Shared\MySqlLocator.cs" Link="Shared\MySqlLocator.cs" />
    <Compile Include="..\Shared\MsSqlSupport.cs" Link="Shared\MsSqlSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CloudOrc.Backup.Worker.Tests" />
  </ItemGroup>
</Project>
